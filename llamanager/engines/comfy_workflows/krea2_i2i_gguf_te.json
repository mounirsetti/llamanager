{
  "_comment": [
    "Krea 2 Turbo image-to-image: a reference image is the STARTING POINT,",
    "not conditioning. The reference is VAE-encoded, partially re-noised and",
    "denoised from there \u2014 generic diffusion img2img, which needs no edit",
    "LoRA and no image-conditioning path in the model. DENOISE is the",
    "strength dial: 0 returns the reference unchanged, 1 ignores it.",
    "Derived from the krea2_t2i pair; the _te variant differs only in node",
    "3, which loads the conditioner through CLIPLoaderGGUF.",
    "Node ids are strings because this is API format (POST /prompt).",
    "Tokens __NAME__ are replaced by _comfy_runner.py."
  ],
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "__UNET__"
    }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora_name": "__LORA__",
      "strength_model": "__LORA_STRENGTH__"
    }
  },
  "3": {
    "class_type": "CLIPLoaderGGUF",
    "inputs": {
      "clip_name": "__CLIP__",
      "type": "krea2"
    }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "__VAE__"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "3",
        0
      ],
      "text": "__PROMPT__"
    }
  },
  "6": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "5",
        0
      ]
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "2",
        0
      ],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "positive": [
        "5",
        0
      ],
      "negative": [
        "6",
        0
      ],
      "latent_image": [
        "13",
        0
      ],
      "denoise": "__DENOISE__"
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "filename_prefix": "llamanager/krea2"
    }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__REF_IMAGE__"
    }
  },
  "12": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "11",
        0
      ],
      "upscale_method": "lanczos",
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "crop": "center"
    }
  },
  "13": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "12",
        0
      ],
      "vae": [
        "4",
        0
      ]
    }
  }
}
