+def qwen3vl_deepstack_rename(sd, indexes=(5, 11, 17)):
+    # llama.cpp names DeepStack mergers by the vision layer they tap;
+    # HF/Comfy index them 0..N-1 in that same order.
+    out = {}
+    for k, v in sd.items():
+        m = re.match(r"^v\.deepstack\.(\d+)\.(fc1|fc2|norm)\.(.*)$", k)
+        if m and int(m.group(1)) in indexes:
+            i = indexes.index(int(m.group(1)))
+            part = {"fc1": "linear_fc1", "fc2": "linear_fc2", "norm": "norm"}[m.group(2)]
+            k = f"model.visual.deepstack_merger_list.{i}.{part}.{m.group(3)}"
+        out[k] = v
+    return out
